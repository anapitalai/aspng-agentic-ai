# Copy this file to .env and fill in real credentials.
# Never commit .env to version control.

# ── MCP Server Authentication ─────────────────────────────────────────────────
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

# ── Microsoft Agents SDK (Copilot SDK) ────────────────────────────────────────
# Required: Azure AD app registration for the bot service connection
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Optional: Microsoft Graph OAuth connection (for user auth flows)
CONNECTIONS__GRAPH__TYPE=OAuthConnection
CONNECTIONS__GRAPH__SETTINGS__CLIENTID=
CONNECTIONS__GRAPH__SETTINGS__CLIENTSECRET=
CONNECTIONS__GRAPH__SETTINGS__TENANTID=
CONNECTIONS__GRAPH__SETTINGS__SCOPES=User.Read,email

# ── Application Server ────────────────────────────────────────────────────────
HOST=localhost
PORT=3978