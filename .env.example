# Copy this file to .env and fill in real credentials.
# Never commit .env to version control.

# ── GitHub Copilot SDK Authentication ─────────────────────────────────────────
# The GitHub Copilot SDK authenticates via the local `gh` CLI by default.
# Set GITHUB_TOKEN to override with a Personal Access Token that has
# the `copilot` scope.
GITHUB_TOKEN=

# ── MCP Server Authentication ─────────────────────────────────────────────────
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=